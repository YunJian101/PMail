# 依赖与构建产物
node_modules/
/web/dist/
# 前端产物由构建脚本生成；留个空占位让 go:embed 在没有产物时也能编译
/server/listen/http_server/dist/*
!/server/listen/http_server/dist/.gitkeep
*.local

# Go 产物
/pmail
/pmail_*
/server/pmail
/server/pmail_*

# 运行时数据
/config/
*.db
*.db-shm
*.db-wal

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# 本地脚手架（不参与构建）
preview/
pmail-src/
upstream/
tmp-*.db

# 本地环境变量
.env

# TypeScript 增量构建信息
*.tsbuildinfo

# 飞牛 fpk 产物（tools/build-fpk.ps1 生成）
/release/
packaging/fnos/pkg/app/pmail
packaging/fnos/pkg/*.fpk
/build/
/.tmp/
